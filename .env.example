DATABASE_URL="file:./prisma/dev.db"
NEXTAUTH_SECRET="change-me-local-only"
NEXTAUTH_URL="http://localhost:3000"
DISCOVERY_MODE="fixture"

# Optional live providers (P2). Leave unset → fixtures. Never commit real keys.
# GOOGLE_PLACES_API_KEY=
# TICKETMASTER_API_KEY=
# When DISCOVERY_MODE=live and keys exist, LiveDiscoveryProvider calls those APIs
# and merges with the seed catalog. SAMPLE/seed public stars are stripped so they
# never look like live ratings.

# Optional admin triage inbox (Casey demo always allowed on localhost)
# ADMIN_EMAIL=you@example.com

# Phase-later email digest webhook (documented stub — not wired)
# DIGEST_WEBHOOK_URL=
