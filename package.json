{
  "name": "local-life",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "dev": "npm run setup && next dev",
    "build": "next build",
    "start": "next start",
    "test": "prisma generate && vitest run",
    "test:e2e": "npm run setup && next build && node scripts/smoke.mjs",
